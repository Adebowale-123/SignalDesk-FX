# Copy to .env for local use. On a host (e.g. Render) set these as environment variables instead.
DEBUG=True
SECRET_KEY=change-me-to-a-long-random-string
ALLOWED_HOSTS=localhost,127.0.0.1
CSRF_TRUSTED_ORIGINS=
# Leave empty for SQLite locally; on a host use the PostgreSQL URL.
DATABASE_URL=
TIME_ZONE=Africa/Lagos

# Run the analysis when someone opens the portal (for free hosting without a background worker).
ENGINE_ON_REQUEST=False

# Email alerts (optional). The console backend just prints emails.
EMAIL_BACKEND=django.core.mail.backends.console.EmailBackend
EMAIL_HOST=
EMAIL_PORT=587
EMAIL_HOST_USER=
EMAIL_HOST_PASSWORD=
EMAIL_USE_TLS=True
DEFAULT_FROM_EMAIL=SignalDesk FX <alerts@example.com>

# Data provider keys and the Telegram bot are set inside the portal: Settings -> Data source / Alerts.
